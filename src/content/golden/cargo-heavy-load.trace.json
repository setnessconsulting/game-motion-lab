      "expectedSamplesDigest": "8536b355",
      "expectedFinalState": {
        "positionMetres": 4,
        "velocityMetresPerSecond": 4,
        "accelerationMetresPerSecondSquared": 2,
        "netForceNewtons": 6,
        "elapsedSeconds": 2
      }
    }
