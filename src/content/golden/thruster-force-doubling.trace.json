{
  "schemaVersion": 1,
  "scenarioId": "thruster-force-doubling",
  "familyId": "thruster-test",
  "rationale": "The simplest force-proportionality pair: one variable moves, the numbers land on clean magnitudes, and the ratio is visible without arithmetic burden.",
  "trials": [
