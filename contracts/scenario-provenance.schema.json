{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setnessconsulting.github.io/game-motion-lab/contracts/scenario-provenance.schema.json",
  "title": "Motion Lab canonical scenario provenance manifest",
  "description": "Machine-readable science provenance for one canonical Motion Lab scenario. Authored in ML-05 (GAME-389) and enforced by the content validator. GAME-382 is the Jira authority; GAME-383 froze this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "familyId",
    "title",
    "targetStandard",
    "scienceConcepts",
    "independentVariable",
    "dependentVariable",
    "controlledVariables",
    "units",
    "initialConditions",
    "expectedRelationship",
    "acceptedEvidence",
    "misconceptions",
    "debriefExplanation",
    "reviewStatus",
    "reviewer",
    "referenceBasis",
    "answerTolerance",
    "expectedTraces",
    "difficultyLevel",
    "graphRequirement"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "stable unique kebab-case identifier"
    },
    "familyId": {
      "enum": ["calibration-run", "thruster-test", "cargo-load-test", "mystery-cart"]
    },
    "variantOf": {
      "type": ["string", "null"],
      "description": "scenarioId of the base scenario when this is a seeded/content variant"
    },
    "seed": {
      "type": ["integer", "null"],
      "description": "explicit deterministic seed for content variation; never used inside authoritative motion"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "targetStandard": {
      "const": "NGSS MS-PS2-2"
    },
    "scienceConcepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "balanced-force",
          "unbalanced-force",
          "net-force",
          "mass",
          "position",
          "elapsed-time",
          "velocity",
          "acceleration",
          "controlled-investigation",
          "proportional-reasoning",
          "inverse-proportional-reasoning",
          "resistive-force",
          "graph-interpretation",
          "evidence-from-multiple-trials"
        ]
      }
    },
    "independentVariable": {
      "type": "string",
      "minLength": 1,
      "description": "the single variable the learner changes in the assessed comparison"
    },
    "dependentVariable": {
      "type": "string",
      "minLength": 1,
      "description": "the variable measured"
    },
    "controlledVariables": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "variables held fixed and named explicitly"
    },
    "units": {
      "type": "object",
      "description": "SI units per quantity, consistent with contracts/science-conventions.v1.json",
      "additionalProperties": false,
      "required": ["mass", "force", "position", "time", "velocity", "acceleration"],
      "properties": {
        "mass": { "const": "kg" },
        "force": { "const": "N" },
        "netForce": { "const": "N" },
        "position": { "const": "m" },
        "time": { "const": "s" },
        "velocity": { "const": "m/s" },
        "acceleration": { "const": "m/s^2" }
      }
    },
    "initialConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positionMetres", "velocityMetresPerSecond", "appliedForcesNewtons"],
      "properties": {
        "positionMetres": { "type": "number" },
        "velocityMetresPerSecond": { "type": "number" },
        "appliedForcesNewtons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "resistiveForceNewtons": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "declared constant resistive magnitude; null when the scenario does not model resistance"
        },
        "observationWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "cartMassKilograms": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "expectedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "governingEquations"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "governingEquations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "net-force-composition",
              "newton-second-law",
              "velocity-time",
              "position-time",
              "balanced-forces"
            ]
          }
        }
      }
    },
    "acceptedEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "what counts as sufficient evidence for a complete claim"
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "remediation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "statement": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 }
        }
      },
      "description": "each misconception mapped to its authored remediation text"
    },
    "debriefExplanation": {
      "type": "string",
      "minLength": 1,
      "description": "authored explanatory debrief"
    },
    "reviewStatus": {
      "enum": ["unreviewed", "in-review", "reviewed", "changes-required"]
    },
    "reviewer": {
      "type": ["string", "null"],
      "description": "reviewer identity; must be non-null when reviewStatus is reviewed"
    },
    "reviewDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "referenceBasis": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 },
      "description": "external scientific reference basis where it matters, otherwise null"
    },
    "answerTolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative", "absoluteSource"],
      "properties": {
        "relative": { "type": "number", "minimum": 0.01, "maximum": 0.05 },
        "absoluteSource": { "const": "science-conventions.v1.json:quantity.toleranceFloor" }
      }
    },
    "expectedTraces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "references to ML-03/ML-04 golden traces that back the expected values"
    },
    "difficultyLevel": {
      "enum": ["guided", "supported", "independent", "diagnosis", "evidence-challenge"]
    },
    "graphRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "graphs"],
      "properties": {
        "level": { "enum": ["none", "optional", "required"] },
        "graphs": {
          "type": "array",
          "items": { "enum": ["position-time", "velocity-time"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": "none" } }, "required": ["level"] },
          "then": { "properties": { "graphs": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "level": { "const": "required" } }, "required": ["level"] },
          "then": { "properties": { "graphs": { "minItems": 1 } } }
        }
      ]
    },
    "answerKeyBounded": {
      "type": "boolean",
      "description": "true when the correct answer cannot be obtained without controlled evidence"
    }
  }
}
